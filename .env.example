# Copy to .env and fill in. .env is gitignored - never commit real credentials.
#
#   cp .env.example .env
#
# Any set of accounts works, as long as all six belong to the SAME club and
# each holds the role its name says. Two ways to get them:
#
#   - Hand-made accounts: whatever password you set them up with.
#   - The admin "Demo Clubs" tool: seeds a populated club plus one login per
#     role, emails shaped demo+<clubid>-<role>@martialdemo.test, all sharing
#     the password Demo@1234. See manual-qa/00-start-here.md section 3.
#
# DEMO_PASSWORD is simply the shared password of whichever set you use; it is
# not required to be the Demo Clubs default.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# Which target to run against: local (default) or dev.
# Prefer the npm scripts: `npm test` = local, `npm run test:dev` = deployed.
# TEST_ENV=local

# Local frontend origin. Both the frontend and backend default to port 3000,
# so the frontend is commonly run on 3001 locally - set whichever you use.
# LOCAL_BASE_URL=http://localhost:3000

# Deployed testing environment (auto-deploys from the develop branch).
DEV_BASE_URL=https://dev-testing.martialapps.com

# The REST API origin. NOTE: this is a DIFFERENT host from the frontend - the
# app does not proxy /api, so https://dev-testing.martialapps.com/api is a 404.
# Sensible defaults are built in per environment:
#   local -> http://localhost:3000/api
#   dev   -> https://devapi-testing.martialapps.com/api
# Set this only to override them (e.g. frontend on :3001, backend on :3000).
# API_BASE_URL=http://localhost:3000/api

# Cookie namespace. Must match NEXT_PUBLIC_APP_ID in the frontend. Built-in
# defaults already handle this per environment (plain "martial_frontend"
# locally, "martial_frontend_testing" against dev - the deployed testing
# build namespaces its cookies to avoid colliding with production on the same
# parent domain). Set this only if your setup differs from both.
# APP_ID=

# Pin a specific club when an account belongs to several. Leave unset to use
# the owner's first club (discovered automatically).
# TEST_CLUB_ID=

# ---------------------------------------------------------------------------
# Test accounts - all must belong to the SAME club, each holding its own role
# ---------------------------------------------------------------------------
# The password your six accounts share. Demo Clubs seeds use Demo@1234.
DEMO_PASSWORD=

# Gmail trick: you+owner@gmail.com all land in you@gmail.com, so one real
# inbox can hold all six accounts (manual-qa/00-start-here.md section 3).
ROLE_OWNER_PRIMARY_EMAIL=
ROLE_CO_OWNER_EMAIL=
ROLE_SENSEI_EMAIL=
ROLE_SECRETARY_EMAIL=
ROLE_MEMBER_EMAIL=
ROLE_PARENT_EMAIL=

# Per-account password overrides, only if an account differs from DEMO_PASSWORD.
# ROLE_OWNER_PRIMARY_PASSWORD=
# ROLE_CO_OWNER_PASSWORD=
# ROLE_SENSEI_PASSWORD=
# ROLE_SECRETARY_PASSWORD=
# ROLE_MEMBER_PASSWORD=
# ROLE_PARENT_PASSWORD=

# The child profile inside the parent account's household (smoke group 14).
# Not a login - a child is reached by signing in as ROLE_PARENT and switching
# profile with this PIN. The PIN is stored hashed server-side and cannot be
# discovered from the API like every other id here, so it has to be written
# down. Must match a profile created by ONB-021 in the target environment.
ROLE_PARENT_CHILD_NAME=
ROLE_PARENT_CHILD_PIN=
